POSTGRES_DB=pawfit
POSTGRES_USER=pawfit
POSTGRES_PASSWORD=pawfit-local

# Supabase: Connect > Session pooler > JDBC (port 5432), with sslmode=require.
DB_URL=jdbc:postgresql://your-pooler-host:5432/postgres?sslmode=require
DB_USERNAME=postgres.your-project-ref
DB_PASSWORD=replace-me
JPA_DDL_AUTO=update

# Comma-separated frontend origins.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Configure when the auth domain is implemented. Use at least 32 random bytes.
JWT_SECRET=replace-with-a-long-random-secret

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-me
SUPABASE_STORAGE_BUCKET=pawfit
STORAGE_MAX_FILE_SIZE=10485760
STORAGE_ALLOWED_CONTENT_TYPES=image/jpeg,image/png,image/webp,application/pdf
STORAGE_SIGNED_URL_TTL=5m
STORAGE_TIMEOUT=10s

AI_PROVIDER=GEMINI
AI_TIMEOUT=30s
AI_MAX_RETRIES=2
AI_RETRY_DELAY=500ms
GEMINI_API_KEY=replace-me
GEMINI_MODEL=gemini-2.5-flash

# Required only when AI_PROVIDER=WORKERS_AI.
CLOUDFLARE_ACCOUNT_ID=replace-me
CLOUDFLARE_API_TOKEN=replace-me
CLOUDFLARE_TEXT_MODEL=@cf/meta/llama-3.1-8b-instruct
CLOUDFLARE_VISION_MODEL=@cf/meta/llama-3.2-11b-vision-instruct
