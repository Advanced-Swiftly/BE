POSTGRES_DB=pawfit
POSTGRES_USER=pawfit
POSTGRES_PASSWORD=pawfit-local

# Supabase: Connect > Session pooler > JDBC (port 5432), with sslmode=require.
DB_URL=jdbc:postgresql://your-pooler-host:5432/postgres?sslmode=require
DB_USERNAME=postgres.your-project-ref
DB_PASSWORD=replace-me
JPA_DDL_AUTO=update

# Comma-separated frontend origins.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# JWT와 휴대전화 인증 만료·rate limit 설정. JWT secret은 32 byte 이상을 사용합니다.
JWT_SECRET=replace-with-a-long-random-secret
AUTH_ACCESS_TOKEN_TTL=30m
AUTH_REFRESH_TOKEN_TTL=30d
PHONE_VERIFICATION_CODE_TTL=3m
PHONE_VERIFICATION_TOKEN_TTL=10m
PHONE_VERIFICATION_RESEND_COOLDOWN=1m
PHONE_VERIFICATION_HOURLY_LIMIT=5
PHONE_VERIFICATION_MAX_ATTEMPTS=5
# 시연 환경에서만 true로 설정합니다. 실제 운영 전 반드시 false로 전환합니다.
PHONE_VERIFICATION_DEMO_ENABLED=false
PHONE_VERIFICATION_DEMO_CODE=123456

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-me
SUPABASE_STORAGE_BUCKET=pawfit
STORAGE_MAX_FILE_SIZE=10485760
STORAGE_ALLOWED_CONTENT_TYPES=image/jpeg,image/png,image/webp,application/pdf
STORAGE_SIGNED_URL_TTL=5m
STORAGE_TIMEOUT=10s

AI_PROVIDER=GEMINI
AI_TIMEOUT=30s
AI_MAX_RETRIES=2
AI_RETRY_DELAY=500ms
GEMINI_API_KEY=replace-me
GEMINI_MODEL=gemini-3.8-flash

# Required only when AI_PROVIDER=WORKERS_AI.
CLOUDFLARE_ACCOUNT_ID=replace-me
CLOUDFLARE_API_TOKEN=replace-me
CLOUDFLARE_TEXT_MODEL=@cf/meta/llama-3.1-8b-instruct
CLOUDFLARE_VISION_MODEL=@cf/meta/llama-3.2-11b-vision-instruct
